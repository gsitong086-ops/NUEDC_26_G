/* USER CODE BEGIN Header */
/**
  * @file    main.c
  * @brief   STM32F407ZGT6 + AD9226 并行ADC采集
  *          淘晶驰串口屏波形显示 (TJC协议, 115200bps)
  */
/* USER CODE END Header */
/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include "dma.h"
#include "tim.h"
#include "usart.h"
#include "gpio.h"

/* Private includes ----------------------------------------------------------*/
/* USER CODE BEGIN Includes */
#include <string.h>
#include "waveform_display.h"
#include "hmi.h"
#include "fft_analysis.h"
#include "problem3.h"
#include "digital_lpf.h"
/* USER CODE END Includes */

/* Private typedef -----------------------------------------------------------*/
/* USER CODE BEGIN PTD */

/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */

/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/

/* USER CODE BEGIN PV */


uint16_t adc_buffer[ADC_SAMPLE_LEN]; // DMA采集缓冲区
volatile uint8_t dma_complete_flag = 0;
extern TIM_HandleTypeDef htim8;
extern DMA_HandleTypeDef hdma_tim8_up;

/* 串口屏按钮相关 -----------------------------------------*/
volatile uint8_t capture_on = 1;     // 采集/显示开关 (1=运行, 0=暂停)
uint8_t  rx_byte;                    // UART中断接收的单个字节
uint8_t  rx_buf[32];                 // 接收缓冲区
uint8_t  rx_idx = 0;                 // 缓冲区索引

/* X/Y 缩放参数 — 屏幕控件自带缩放功能 */
int g_hzoom = 1;   // 保留串口屏原有X缩放初值
int g_scale = 1;   // Y轴缩放，无上下限
volatile uint8_t zoom_dirty = 0;  // 缩放值已变更，主循环需发送
volatile uint8_t  page0_ready = 1; // 1=page0空闲可切模式
volatile uint32_t page0_tick  = 0; // PAGE0接收时刻
volatile uint8_t  clear_all_pending = 0; // ISR→主循环: 1=需执行ClearAll
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
/* USER CODE BEGIN PFP */
void AD9226_GPIO_Init(void);
void AD9226_StartSampling(void);
void AD9226_StopSampling(void);
void HMI_RxHandler(uint8_t b);
/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */

/**
 * @brief 配置GPIOD PD0~PD11为输入，读取AD9226的12位并行数据
 */
void AD9226_GPIO_Init(void)
{
    __HAL_RCC_GPIOD_CLK_ENABLE();

    GPIO_InitTypeDef GPIO_InitStruct = {0};
    GPIO_InitStruct.Pin = GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 | GPIO_PIN_3 |
                          GPIO_PIN_4 | GPIO_PIN_5 | GPIO_PIN_6 | GPIO_PIN_7 |
                          GPIO_PIN_8 | GPIO_PIN_9 | GPIO_PIN_10 | GPIO_PIN_11;
    GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_VERY_HIGH;
    HAL_GPIO_Init(GPIOD, &GPIO_InitStruct);
}

/**
 * @brief 启动一次DMA采样 (TIM8触发, 采集1024点)
 */
void AD9226_StartSampling(void)
{
    dma_complete_flag = 0;

    // 停止TIM8
    TIM8->CR1 &= ~TIM_CR1_CEN;

    // 禁止DMA, 等待真正停止
    DMA2_Stream1->CR &= ~DMA_SxCR_EN;
    while (DMA2_Stream1->CR & DMA_SxCR_EN);

    // 清除DMA中断标志
    DMA2->LIFCR = 0x3D << 6;

    // 设置源/目标地址和传输长度
    DMA2_Stream1->PAR  = (uint32_t)&GPIOD->IDR;
    DMA2_Stream1->M0AR = (uint32_t)adc_buffer;
    DMA2_Stream1->NDTR = ADC_SAMPLE_LEN;

    // 使能DMA传输完成中断
    DMA2_Stream1->CR |= DMA_SxCR_TCIE;

    // 使能DMA
    DMA2_Stream1->CR |= DMA_SxCR_EN;

    // 使能TIM8 UPDATE触发DMA
    TIM8->DIER |= TIM_DIER_UDE;

    // 清除SR，启动TIM8
    TIM8->SR = 0;
    TIM8->CR1 |= TIM_CR1_CEN;
}

/**
 * @brief 停止采样
 */
void AD9226_StopSampling(void)
{
    TIM8->CR1 &= ~TIM_CR1_CEN;         // 停止TIM8
    DMA2_Stream1->CR &= ~DMA_SxCR_EN;  // 禁止DMA
}

/**
 * @brief 串口屏按钮指令处理
 *
 * 按钮事件: START / PAUSE / CLEAR / XP / XM / YP / YM
 * 也兼容淘晶驰标准触摸事件格式 (0x65前缀, 7字节)
 */
void HMI_RxHandler(uint8_t b)
{
    /* PAUSE/CLEAR快速匹配：即使前面夹有屏幕错误返回帧也能立即响应。 */
    static const uint8_t pause_cmd[] = {'P', 'A', 'U', 'S', 'E'};
    static const uint8_t clear_cmd[] = {'C', 'L', 'E', 'A', 'R'};
    static uint8_t pause_pos = 0U;
    static uint8_t clear_pos = 0U;

    if (b == pause_cmd[pause_pos])
    {
        if (++pause_pos >= sizeof(pause_cmd))
        {
            capture_on = 0U;
            pause_pos = clear_pos = rx_idx = 0U;
            return;
        }
    }
    else { pause_pos = (b == pause_cmd[0]) ? 1U : 0U; }

    if (b == clear_cmd[clear_pos])
    {
        if (++clear_pos >= sizeof(clear_cmd))
        {
            capture_on = 0U;
            clear_all_pending = 1U;
            pause_pos = clear_pos = rx_idx = 0U;
            return;
        }
    }
    else { clear_pos = (b == clear_cmd[0]) ? 1U : 0U; }
    /* 淘晶驰触摸帧 0x65 — 收齐7字节，处理按钮事件 */
    if (rx_idx == 0 && b == 0x65) { rx_buf[0] = 0x65; rx_idx = 1; return; }
    if (rx_idx > 0 && rx_buf[0] == 0x65)
    {
        rx_buf[rx_idx++] = b;
        if (rx_idx >= 7)
        {
            rx_idx = 0;
            uint8_t cid = rx_buf[2];  // 控件ID
            if      (cid == 1)  { capture_on = 1; }
            else if (cid == 2)  { capture_on = 0; }
            else if (cid == 3)  { capture_on = 0; clear_all_pending = 1; }
            else if (cid == 13) { g_hzoom -= 2; zoom_dirty = 1; capture_on = 0; }
            else if (cid == 14) { g_hzoom += 2; zoom_dirty = 1; capture_on = 0; }
            else if (cid == 15) { g_scale += 5; zoom_dirty = 1; capture_on = 0; }
            else if (cid == 16) { g_scale -= 5; zoom_dirty = 1; capture_on = 0; }
            else if (cid == 6)
            {
                /* b2 按钮: 请求切换题目三模式 (在主循环中安全执行) */
                capture_on = 0;
                problem3_pending = problem3_mode ? 2U : 1U;
            }

            /* 限幅: 防止步进过大超出有效范围 */
            if (g_hzoom < -20)  g_hzoom = -20;
            if (g_hzoom > 30)   g_hzoom = 30;
            if (g_scale < -30)  g_scale = -30;
            if (g_scale > 30)   g_scale = 30;
        }
        return;
    }

    /* printh ASCII字符串 (以 \r 或 \n 结尾) */
    if (b == '\r' || b == '\n')
    {
        /* 跳过孤立的换行符 (多条命令之间的 \r\n 残留) */
        if (rx_idx == 0) { return; }

        rx_buf[rx_idx] = '\0';
        char *cmd = (char *)rx_buf;
        rx_idx = 0;

        if      (strcmp(cmd, "START") == 0)
            { capture_on = 1; /* Draw 函数内部自带 Clear，无需重复 */ }
        else if (strcmp(cmd, "PAUSE") == 0)
            { capture_on = 0; }
        else if (strcmp(cmd, "CLEAR") == 0)
            { capture_on = 0; clear_all_pending = 1; }
        else if (strcmp(cmd, "XP") == 0)
            { g_hzoom -= 1; zoom_dirty = 1; capture_on = 0; }
        else if (strcmp(cmd, "XM") == 0)
            { g_hzoom += 1; zoom_dirty = 1; capture_on = 0; }
        else if (strcmp(cmd, "YP") == 0)
            { g_scale += 1; zoom_dirty = 1; capture_on = 0; }
        else if (strcmp(cmd, "YM") == 0)
            { g_scale -= 1; zoom_dirty = 1; capture_on = 0; }
        else if (strcmp(cmd, "PAGE0") == 0)
        {
            capture_on = 0;
            page0_ready = 0;
            page0_tick  = HAL_GetTick();
        }
        else if (strcmp(cmd, "MODE3") == 0)
        {
            capture_on = 0;
            HAL_GPIO_WritePin(GPIOE, GPIO_PIN_6, GPIO_PIN_SET);
            if (!problem3_mode) { problem3_pending = 1U; }
        }
        /* 限幅: 防止步进过大超出有效范围 */
        if (g_hzoom < -20)  g_hzoom = -20;
        if (g_hzoom > 30)   g_hzoom = 30;
        if (g_scale < -30)  g_scale = -30;
        if (g_scale > 30)   g_scale = 30;

        return;
    }

    /* 存储普通字符 */
    if (rx_idx < sizeof(rx_buf) - 1)
        rx_buf[rx_idx++] = b;

    /* hex printh 裸字节序列检测 (不带 \r\n) — 4 字节即触发 */
    if (rx_idx >= 4U)
    {
        uint8_t b0 = rx_buf[rx_idx - 4U];
        uint8_t b1 = rx_buf[rx_idx - 3U];
        uint8_t b2 = rx_buf[rx_idx - 2U];
        uint8_t b3 = rx_buf[rx_idx - 1U];

        /* 题目3: 79 70 3D 3A → PE6 始终 HIGH */
        if (page0_ready &&
            b0 == 0x79 && b1 == 0x70 && b2 == 0x3D && b3 == 0x3A)
        {
            capture_on = 0;
            HAL_GPIO_WritePin(GPIOE, GPIO_PIN_6, GPIO_PIN_SET);
            if (!problem3_mode) { problem3_pending = 1U; }
            rx_idx = 0;
        }
        /* 题目1: 89 80 8D 8A → PE6 LOW (点击即切换直通支路) */
        else if (b0 == 0x89 && b1 == 0x80 && b2 == 0x8D && b3 == 0x8A)
        {
            capture_on = 0;
            HAL_GPIO_WritePin(GPIOE, GPIO_PIN_6, GPIO_PIN_RESET);
            if (problem3_mode)
                problem3_pending = 2U;
            rx_idx = 0;
        }
        /* 题目2: 99 90 9D 9A → PE6 LOW (点击即切换直通支路) */
        else if (b0 == 0x99 && b1 == 0x90 && b2 == 0x9D && b3 == 0x9A)
        {
            capture_on = 0;
            HAL_GPIO_WritePin(GPIOE, GPIO_PIN_6, GPIO_PIN_RESET);
            if (problem3_mode)
                problem3_pending = 2U;
            rx_idx = 0;
        }
        /* page0 加载完成: printh 00 00 00 01 → 就绪, 接受题目3 */
        else if (b0 == 0x00 && b1 == 0x00 && b2 == 0x00 && b3 == 0x01)
        {
            capture_on = 0;
            page0_ready = 1;
            rx_idx = 0;
        }
    }
}

/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_TIM8_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */

    AD9226_GPIO_Init();
    HAL_TIM_PWM_Start(&htim8, TIM_CHANNEL_1);
    if (FFT_Analysis_Init() == 0U)
    {
        Error_Handler();
    }

    Problem3_Init();  /* 继电器 + 数字 LPF 就绪; 默认直连通路 */

    /* 使能USART1接收中断 (用于接收串口屏按钮指令) */
    HAL_NVIC_SetPriority(USART1_IRQn, 1, 0);
    HAL_NVIC_EnableIRQ(USART1_IRQn);
    HAL_UART_Receive_IT(&huart1, &rx_byte, 1);

    /* 等待串口屏启动完成 */
    HAL_Delay(3000);
    HMI_SendRaw("bkcmd=0");  /* 禁止无效控件命令返回错误帧 */
    HAL_Delay(20U);

    WaveformDisplay_Init(g_hzoom, g_scale);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
    while (1)
    {
        /* page0 加载等待: 收到 PAGE0 后等 1s 才能切模式 */
        if (!page0_ready && HAL_GetTick() - page0_tick > 1000U)
            { page0_ready = 1; }

        /* ==== 处理 CLEAR 请求 (来自中断的 pending flag) ==== */
        if (clear_all_pending)
        {
            WaveformDisplay_ClearAll();
            clear_all_pending = 0;
        }

        /* ==== 处理题目三模式切换请求 (来自中断的 pending flag) ==== */
        if (problem3_pending)
        {
            if (problem3_pending == 1U)
            {
                Problem3_Enter(g_hzoom, g_scale);
                capture_on = 1U;
            }
            else
            {
                Problem3_Exit();
            }
            problem3_pending = 0U;
        }

        /* ---- 等待采集开关 ---- */
        if (!capture_on)
        {
            /* 缩放触发的暂停: 立即应用 zoom 并重画, 不延时 */
            if (zoom_dirty)
            {
                if (problem3_mode)
                {
                    WaveformDisplay_ApplyZoomP3(g_hzoom, g_scale);
                }
                else
                {
                    WaveformDisplay_ApplyZoom(g_hzoom, g_scale);
                }
                zoom_dirty = 0;
                capture_on = 1;
                /* 复用上次采样数据, 仅重画波形 */
            }
            else
            {
                HAL_Delay(50);
                continue;
            }
        }

        /* ---- 启动DMA采样 ---- */
        AD9226_StartSampling();

        /* ---- 等待DMA完成 (1秒超时) ---- */
        uint32_t timeout = HAL_GetTick();
        while (!dma_complete_flag)
        {
            if (!capture_on) { AD9226_StopSampling(); break; }
            if (HAL_GetTick() - timeout > 1000)
            {
                AD9226_StopSampling();
                break;
            }
        }

        /* ---- 绘制波形图：滤波和串口屏发送已封装到独立模块 ---- */
        if (dma_complete_flag && capture_on)
        {
            /* ==== 题目三: 数字 LPF 抑制 1~1.5MHz 干扰 (在 FFT 之前) ==== */
            if (problem3_mode)
            {
                DigitalLPF_Apply(adc_buffer, ADC_SAMPLE_LEN);
            }

            if (FFT_Analysis_Run(adc_buffer, ADC_SAMPLE_LEN, 500000.0f) != 0U)
            {
                if (problem3_mode)
                {
                    (void)FFT_ReconstructIFFT(adc_buffer, ADC_SAMPLE_LEN);
                }
                FFT_ComputeUpp();

                if (problem3_mode)
                {
                    /* ── 题目三: 更新 t3_xxx 文本控件 ── */
                    WaveformDisplay_SetFrequencyHz("t3_f0",
                                                   g_fft_result.fundamental_hz);
                    WaveformDisplay_SetFrequencyHz("t3_fa1",
                                                   g_fft_result.fundamental_hz);
                    WaveformDisplay_SetAmplitudeMV("t3_h0",
                                                   g_fft_result.peak_magnitude);
                    WaveformDisplay_SetFrequencyHz("t3_f1",
                                                   g_fft_result.harmonic1_hz);
                    WaveformDisplay_SetAmplitudeMV("t3_h1",
                                                   g_fft_result.harmonic1_magnitude);
                    WaveformDisplay_SetFrequencyHz("t3_f2",
                                                   g_fft_result.harmonic2_hz);
                    WaveformDisplay_SetAmplitudeMV("t3_h2",
                                                   g_fft_result.harmonic2_magnitude);
                    WaveformDisplay_SetRMSMV("t3_urms",
                                             g_fft_result.rms_mv);
                    WaveformDisplay_SetUppMV("t3_upp",
                                             g_fft_result.upp_mv);
                }
                else
                {
                    /* ── 题目1/2: 更新 t1_xxx 文本控件 (不变) ── */
                    WaveformDisplay_SetFrequencyHz("t1_f0",
                                                   g_fft_result.fundamental_hz);
                    WaveformDisplay_SetFrequencyHz("t1_fa1",
                                                   g_fft_result.fundamental_hz);
                    WaveformDisplay_SetAmplitudeMV("t1_h0",
                                                   g_fft_result.peak_magnitude);
                    WaveformDisplay_SetFrequencyHz("t1_f1",
                                                   g_fft_result.harmonic1_hz);
                    WaveformDisplay_SetAmplitudeMV("t1_h1",
                                                   g_fft_result.harmonic1_magnitude);
                    WaveformDisplay_SetFrequencyHz("t1_f2",
                                                   g_fft_result.harmonic2_hz);
                    WaveformDisplay_SetAmplitudeMV("t1_h2",
                                                   g_fft_result.harmonic2_magnitude);
                    WaveformDisplay_SetRMSMV("t1_urms",
                                             g_fft_result.rms_mv);
                    WaveformDisplay_SetUppMV("t1_upp",
                                             g_fft_result.upp_mv);
                }
            }
            else
            {
                if (problem3_mode)
                {
                    WaveformDisplay_SetFrequencyHz("t3_f0", 0.0f);
                    WaveformDisplay_SetFrequencyHz("t3_fa1", 0.0f);
                    WaveformDisplay_SetAmplitudeMV("t3_h0", 0.0f);
                    WaveformDisplay_SetFrequencyHz("t3_f1", 0.0f);
                    WaveformDisplay_SetAmplitudeMV("t3_h1", 0.0f);
                    WaveformDisplay_SetFrequencyHz("t3_f2", 0.0f);
                    WaveformDisplay_SetAmplitudeMV("t3_h2", 0.0f);
                    WaveformDisplay_SetRMSMV("t3_urms", 0.0f);
                    WaveformDisplay_SetUppMV("t3_upp", 0.0f);
                }
                else
                {
                    WaveformDisplay_SetFrequencyHz("t1_f0", 0.0f);
                    WaveformDisplay_SetFrequencyHz("t1_fa1", 0.0f);
                    WaveformDisplay_SetAmplitudeMV("t1_h0", 0.0f);
                    WaveformDisplay_SetFrequencyHz("t1_f1", 0.0f);
                    WaveformDisplay_SetAmplitudeMV("t1_h1", 0.0f);
                    WaveformDisplay_SetFrequencyHz("t1_f2", 0.0f);
                    WaveformDisplay_SetAmplitudeMV("t1_h2", 0.0f);
                    WaveformDisplay_SetRMSMV("t1_urms", 0.0f);
                    WaveformDisplay_SetUppMV("t1_upp", 0.0f);
                }
            }

            /* ---- 缩放参数变更时立即应用到屏幕控件 ---- */
            if (zoom_dirty)
            {
                if (problem3_mode)
                {
                    WaveformDisplay_ApplyZoomP3(g_hzoom, g_scale);
                }
                else
                {
                    WaveformDisplay_ApplyZoom(g_hzoom, g_scale);
                }
                zoom_dirty = 0;
            }

            if (problem3_mode)
            {
                WaveformDisplay_DrawIFFTP3(g_hzoom, g_scale, &capture_on);
                WaveformDisplay_SpectrumP3(&capture_on);
                WaveformDisplay_DrawSynthesizedP3(&capture_on);
                WaveformDisplay_DrawSynthesized3PP3(&capture_on);
            }
            else
            {
                WaveformDisplay_Spectrum(&capture_on);
                WaveformDisplay_Draw(adc_buffer, FFT_ANALYSIS_SIZE,
                                     g_hzoom, g_scale, &capture_on);
                WaveformDisplay_DrawSynthesized(&capture_on);
                WaveformDisplay_DrawSynthesized3P(&capture_on);
            }
        }
    }
  /* USER CODE END WHILE */

  /* USER CODE BEGIN 3 */
  /* USER CODE END 3 */
}

/**
  * @brief System Clock Configuration
  * @retval None
  */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  /** Configure the main internal regulator output voltage
  */
  __HAL_RCC_PWR_CLK_ENABLE();
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE1);

  /** Initializes the RCC Oscillators according to the specified parameters
  * in the RCC_OscInitTypeDef structure.
  */
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState = RCC_HSE_ON;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM = 8;
  RCC_OscInitStruct.PLL.PLLN = 336;
  RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
  RCC_OscInitStruct.PLL.PLLQ = 4;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
  {
    Error_Handler();
  }

  /** Initializes the CPU, AHB and APB buses clocks
  */
  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK
                              |RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV4;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV2;

  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_5) != HAL_OK)
  {
    Error_Handler();
  }
}

/* USER CODE BEGIN 4 */

/**
 * @brief USART1 接收中断回调 (HAL库自动调用)
 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        HMI_RxHandler(rx_byte);
        HAL_UART_Receive_IT(&huart1, &rx_byte, 1);  // 重新开启接收
    }
}

/* USER CODE END 4 */

